---
import ProjectTile from '@/components/projects/ProjectTile.astro';
import type { ProjectRecord } from '@/data/projects';

interface Props {
  projects: ProjectRecord[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 ? (
    <section
      id="proyectos"
      class="projects-section"
      aria-labelledby="projects-home-title"
      data-horizontal-projects
      data-surface-tone="light"
    >
      <header class="projects-section__header content-shell">
        <h2 id="projects-home-title">Proyectos</h2>
        <p>
          Trabajo que deja marca.{' '}
          <span class="projects-section__hint--swipe">
            Desliza para recorrerlo.
          </span>
          <span class="projects-section__hint--scroll">
            Baja para recorrerlo.
          </span>
        </p>
      </header>
      <div class="projects-section__viewport" data-project-viewport>
        {/* The track is what moves. It holds the pieces and, after the last
            one, the route into the archive, so the rail ends on it. */}
        <div class="projects-section__track" data-project-track>
          <ol class="projects-section__list" role="list">
            {projects.map((project) => (
              <li class="project-tile" data-project-card>
                <ProjectTile project={project} />
              </li>
            ))}
          </ol>
          <div class="projects-section__outro" data-project-outro>
            <a
              class="bite-button projects-section__cta"
              href="/proyectos/"
              data-magnetic
              data-cursor-label="Ver"
            >
              <span>Ver proyectos</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    import.meta.env.DEV && (
      <section
        id="proyectos"
        class="projects-section projects-section--empty"
        aria-labelledby="projects-home-title"
        data-dev-placeholder
        data-surface-tone="light"
      >
        <div class="content-shell">
          <h2 id="projects-home-title">Proyectos</h2>
          <p class="dev-note">
            El carril horizontal está preparado y se activará al publicar el
            primer proyecto aprobado.
          </p>
        </div>
      </section>
    )
  )
}
