---
/**
 * COLMILLO HERO
 *
 * One white canvas with the client loop as the only protagonist. Everything
 * else is deliberately quiet: the wordmark in the top-left corner, the CTA
 * under the animation and a hairline scroll hint below it. Navigation belongs
 * to the edge menu, so the hero only has to leave the right edge clear.
 *
 * The wordmark is the global fixed one (`SiteLogo.astro`, in the layout); the
 * hero keeps an empty box of its size in the top row so the composition under
 * it is unchanged.
 *
 * The loop is decorative — it carries no information that is not already in the
 * page — so it is hidden from assistive technology and every real affordance
 * around it is a genuine link. The scroll hint is pure ornament, hidden from
 * the same tree.
 */
import { heroMedia } from '@/config/assets';
---

<section
  id="inicio"
  class="hero"
  aria-labelledby="hero-title"
  data-hero
  data-surface-tone="light"
>
  <div class="hero__decor" aria-hidden="true">
    <span class="hero__shape hero__shape--disc"></span>
    <span class="hero__shape hero__shape--ring"></span>
  </div>

  <div class="hero__inner">
    <span class="hero__logo" aria-hidden="true"></span>
    <h1 id="hero-title" class="visually-hidden">Colmillo Studio</h1>

    <div class="hero__stage">
      <div class="hero__media-frame">
        <img
          class="hero__poster"
          src={heroMedia.poster}
          alt=""
          width={heroMedia.width}
          height={heroMedia.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          aria-hidden="true"
        />
        <video
          class="hero__media"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroMedia.poster}
          width={heroMedia.width}
          height={heroMedia.height}
          data-motion-video
          aria-hidden="true"
        >
          <source
            src={heroMedia.mobile.webm}
            type="video/webm"
            media="(max-width: 48rem)"
          />
          <source
            src={heroMedia.mobile.mp4}
            type="video/mp4"
            media="(max-width: 48rem)"
          />
          <source
            src={heroMedia.desktop.webm}
            type="video/webm"
            media="(min-width: 48.01rem)"
          />
          <source
            src={heroMedia.desktop.mp4}
            type="video/mp4"
            media="(min-width: 48.01rem)"
          />
        </video>
      </div>

      <a
        class="bite-button hero__cta"
        href="#contacto"
        data-magnetic
        data-cursor-label="Contacto"
      >
        <span>Haz que tu marca muerda</span>
      </a>

      <span class="hero__scroll" aria-hidden="true">
        <span class="hero__scroll-dot"></span>
      </span>
    </div>
  </div>
</section>
