---
/**
 * COLMILLO STUDIO — home goodbye stage (the pre-footer)
 *
 * A fixed viewport over ONE panoramic scene, wider than the screen: the
 * photograph in `goodbyeVisual`. The stage opens on the scene's left side,
 * with the first editorial block in the photograph's left black field; its
 * arrow travels the whole scene sideways, like a camera panning, until the
 * scene's right side fills the screen and the CTA to Contacto arrives in the
 * right black field. A round back button travels everything home. The visual
 * is never swapped, faded or cut: there is one scene element, and it only
 * moves. The orange piece in the middle of the photograph is on screen in
 * both positions, and no copy ever sits on it.
 *
 * `GoodbyePanorama.ts` drives the travel. Portrait screens and no-JavaScript
 * use a band layout: the photograph across the top, the copy below it.
 * Without JavaScript the scene rests on its left side, both blocks are listed
 * and the arrows stay hidden.
 *
 * The copy lives in `src/data/goodbye.ts`. While the stage is not approved as
 * a whole (photograph on trial, provisional kicker: `docs/CONTENT_NEEDED.md`),
 * the section carries `data-dev-placeholder`, which `check:production` forbids
 * in `dist/`.
 */
import { goodbyeVisual } from '@/config/assets';
import type { GoodbyeContent } from '@/data/goodbye';

interface Props {
  content: GoodbyeContent;
}

const { label, start, end, placeholder } = Astro.props.content;

// The scene's width follows the visual's own ratio (`goodbye-section.css`).
const sectionStyle = goodbyeVisual
  ? `--goodbye-ratio: ${goodbyeVisual.width / goodbyeVisual.height}`
  : undefined;

// The arrow is set into the CTA's last word, so the two never wrap apart.
const ctaWords = end.cta.label.trim().split(/\s+/);
const ctaTail = ctaWords.pop() ?? '';
const ctaLead = ctaWords.join(' ');
---

<section
  class="goodbye-section"
  style={sectionStyle}
  aria-labelledby="goodbye-title"
  data-stack-section
  data-surface-tone="dark"
  data-goodbye
  data-goodbye-at="start"
  data-dev-placeholder={placeholder ? '' : undefined}
>
  <div class="goodbye-section__viewport" aria-hidden="true">
    <div class="goodbye-section__scene" data-goodbye-scene>
      {
        goodbyeVisual?.kind === 'video' && (
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={goodbyeVisual.poster}
            width={goodbyeVisual.width}
            height={goodbyeVisual.height}
            tabindex="-1"
            data-goodbye-video
          >
            <source
              src={goodbyeVisual.mobile.webm}
              type="video/webm"
              media="(max-width: 48rem)"
            />
            <source
              src={goodbyeVisual.mobile.mp4}
              type="video/mp4"
              media="(max-width: 48rem)"
            />
            <source
              src={goodbyeVisual.desktop.webm}
              type="video/webm"
              media="(min-width: 48.01rem)"
            />
            <source
              src={goodbyeVisual.desktop.mp4}
              type="video/mp4"
              media="(min-width: 48.01rem)"
            />
          </video>
        )
      }
      {
        goodbyeVisual?.kind === 'image' && (
          <img
            src={goodbyeVisual.src}
            alt=""
            width={goodbyeVisual.width}
            height={goodbyeVisual.height}
            loading="lazy"
            decoding="async"
          />
        )
      }
      {
        !goodbyeVisual && (
          <div class="goodbye-section__placeholder">
            <span class="goodbye-section__mark goodbye-section__mark--disc" />
            <span class="goodbye-section__mark goodbye-section__mark--ring" />
          </div>
        )
      }
    </div>
  </div>

  {/* A polite live region: travelling announces the side that arrives. */}
  <div class="goodbye-section__stops" aria-live="polite">
    <h2 id="goodbye-title" class="visually-hidden">{label}</h2>

    <div class="goodbye-start" data-goodbye-stop="start">
      {/* The arrow and the headline are one composition. */}
      <div class="goodbye-start__head">
        <h3 class="goodbye-start__title">{start.title}</h3>
        <button
          class="goodbye-travel"
          type="button"
          aria-label="Siguiente"
          data-goodbye-travel="next"
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 12h15M13 6l6 6-6 6"></path>
          </svg>
        </button>
      </div>
      {start.body && <p class="goodbye-start__body">{start.body}</p>}
    </div>

    <div class="goodbye-end" data-goodbye-stop="end">
      {/* First in the reading order, as it leads back to the first side. */}
      <button
        class="goodbye-travel goodbye-end__back"
        type="button"
        aria-label="Volver a la vista anterior"
        data-goodbye-travel="back"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 12H5M11 6l-6 6 6 6"></path>
        </svg>
      </button>

      <div class="goodbye-end__copy">
        {
          end.kicker && (
            <p class="goodbye-end__kicker" data-goodbye-reveal>
              {end.kicker}
            </p>
          )
        }
        {/* Headline and note arrive as one line of the reveal. */}
        <div class="goodbye-end__headline" data-goodbye-reveal>
          <h3 class="goodbye-end__title">
            <a class="goodbye-end__cta" href={end.cta.href}>
              <span class="goodbye-end__cta-text">
                {ctaLead && `${ctaLead} `}<span class="goodbye-end__cta-tail"
                  >{ctaTail}<span
                    class="goodbye-end__cta-arrow"
                    aria-hidden="true"
                    ><svg
                      viewBox="0 0 24 24"
                      focusable="false"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M4 12h15M13 6l6 6-6 6"></path></svg
                    ></span
                  ></span
                >
              </span>
              <span class="visually-hidden">, {end.cta.destination}</span>
            </a>
          </h3>
          {end.note && <p class="goodbye-end__note">{end.note}</p>}
        </div>
      </div>
    </div>
  </div>
</section>
