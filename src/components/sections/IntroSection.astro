<section
  id="manifiesto"
  class="stack-section stack-section--cream manifesto-home"
  aria-labelledby="intro-title"
  data-stack-section
  data-surface-tone="light"
>
  <div class="manifesto-home__track" data-manifesto-track>
    <div class="manifesto-home__stage" data-manifesto-stage>
      <div class="content-shell manifesto-home__canvas" data-manifesto-canvas>
        <p class="section-index manifesto-home__index" aria-hidden="true">01</p>
        <p class="section-kicker manifesto-home__kicker">Colmillo / Studio</p>
        <span
          class="manifesto-home__rule"
          aria-hidden="true"
          data-manifesto-rule></span>
        <p class="manifesto-home__tag" aria-hidden="true" data-manifesto-tag>
          Manifiesto
        </p>

        <h2 id="intro-title" class="manifesto-home__title">
          <span
            class="manifesto-home__word manifesto-home__word--morder"
            data-manifesto-word="morder">Morder.</span
          >
          <span
            class="manifesto-home__word manifesto-home__word--presionar"
            data-manifesto-word="presionar">Presionar.</span
          >
          <em
            class="manifesto-home__word manifesto-home__word--marca"
            data-manifesto-word="marca">Dejar marca.</em
          >
        </h2>

        <div class="manifesto-home__shape" aria-hidden="true">
          <span class="manifesto-home__shape-inner" data-manifesto-shape>
            <span class="manifesto-home__skin" data-manifesto-skin>
              <span class="manifesto-home__bite" data-manifesto-bite></span>
            </span>
            <span class="manifesto-home__shape-label">
              Tensión <span>+</span> liberación
            </span>
          </span>
        </div>

        <a
          class="section-route manifesto-home__cta"
          href="/manifiesto/"
          data-cursor-label="Abrir"
          data-manifesto-cta
        >
          Abrir manifiesto <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
