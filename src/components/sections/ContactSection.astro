---
/**
 * COLMILLO STUDIO — home contact close: "la última mordida"
 *
 * White, a large headline with two buttons under it, and one strange orange
 * object beside it that answers the reader. The object is a soft, inflated
 * piece with a large piece missing from its left side, turned towards
 * "muerda". Its geometry comes from `ContactSculpture.ts`: the still pose is
 * rendered here, so no JavaScript, touch and reduced motion get exactly the
 * same object, and `ContactBiteMotion.ts` redraws it live on a fine pointer.
 *
 * The two buttons are the hero's `bite-button`: the approved address, and the
 * way into Contacto. Instagram is not among them — the global control in the
 * top-right corner is already that, on every route.
 *
 * The sculpture is NOT a link (2026-09-23, client direction). It used to be
 * the way into Contacto, which nobody could be expected to guess; the button
 * beside it says so in words.
 *
 * Since 2026-09-24 it is a stress ball and nothing else — no bite, no hole,
 * at the client's word, because the bitten form left readers asking what they
 * were looking at. A fine pointer can press it in, roll it over and pull it
 * out of shape, and the folds in its skin carry all three. It has no name, no
 * role and no focus stop, so nothing is lost by not reaching it: every route
 * out of this section is a real button, and the ball is the reward for
 * staying.
 *
 * Its geometry is a real solid — see `ContactSculpture.ts`. The still pose
 * rendered here is that ball at rest, so no JavaScript, touch and reduced
 * motion get the same object, simply not moving.
 *
 * All type is in sentence case.
 */
import { contactChannels } from '@/config/contact';
import { demoMode } from '@/data/projects';
import {
  RADIUS,
  REST_STATE,
  VIEW_H,
  VIEW_W,
  sculptureFrame,
} from '@/scripts/motion/ContactSculpture';

/*
 * The section's two routes out: the approved address, and Contacto. Instagram
 * is deliberately absent — the global badge in the corner is already it.
 * The address is published only when it exists, so a repository with no
 * approved channel still shows the Contacto button and never an empty row.
 */
const email = contactChannels.email;
const actions = [
  ...(email?.href
    ? [{ label: email.label, href: email.href, external: true }]
    : []),
  { label: 'Contacto', href: '/contacto/', external: false },
];

const rest = sculptureFrame(REST_STATE);
---

<section
  id="contacto"
  class="contact-section"
  aria-labelledby="contact-title"
  data-stack-section
  data-surface-tone="light"
  data-contact-bite
>
  <div class="content-shell contact-bite" data-bite-stage>
    <div class="contact-bite__lead">
      <h2 id="contact-title" class="contact-bite__title">
        <span class="contact-bite__line" data-bite-line="1">
          <span class="contact-bite__word">Haz que</span>
        </span>{' '}
        <span class="contact-bite__line" data-bite-line="2">
          <span class="contact-bite__word">tu marca</span>
        </span>{' '}
        <span
          class="contact-bite__line contact-bite__line--bite"
          data-bite-line="3"
        >
          <em class="contact-bite__word" data-bite-trigger data-cursor-label="">
            muerda
          </em>
        </span>
      </h2>

      <ul class="contact-bite__actions" role="list">
        {
          actions.map((action) => (
            <li data-bite-row>
              <a
                class="bite-button contact-bite__button"
                href={action.href}
                data-magnetic
                data-cursor-label=""
              >
                <span>
                  {action.label}
                  {action.external && <span aria-hidden="true"> ↗</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        demoMode && !email?.href && (
          <p class="dev-note" data-dev-placeholder>
            El correo se activará aquí y en el encabezado cuando se confirmen
            los datos públicos.
          </p>
        )
      }
    </div>

    {/* Decorative and inert: the buttons above are the way on. */}
    <div class="contact-bite__piece" aria-hidden="true" data-bite-piece>
      <svg
        class="contact-bite__sculpture"
        viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
        aria-hidden="true"
        focusable="false"
        data-bite-sculpture
      >
        <defs>
          <path id="cb-body" d={rest.body} data-sculpture="body"></path>
          <clipPath id="cb-clip"><use href="#cb-body"></use></clipPath>
          <radialGradient
            id="cb-light"
            gradientUnits="userSpaceOnUse"
            cx={rest.light.x}
            cy={rest.light.y}
            r={RADIUS}
            data-sculpture="light"
          >
            <stop offset="0" stop-color="#fff" stop-opacity="0.42"></stop>
            <stop offset="0.35" stop-color="#fff" stop-opacity="0.16"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient
            id="cb-shade"
            gradientUnits="userSpaceOnUse"
            cx={rest.shade.x}
            cy={rest.shade.y}
            r={RADIUS * 1.45}
            data-sculpture="shade"
          >
            <stop offset="0.45" stop-color="#12100f" stop-opacity="0"></stop>
            <stop offset="0.8" stop-color="#12100f" stop-opacity="0.14"></stop>
            <stop offset="1" stop-color="#12100f" stop-opacity="0.3"></stop>
          </radialGradient>
          <linearGradient id="cb-bounce" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0.72" stop-color="#fff" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0.16"></stop>
          </linearGradient>
          {
            /* A dip is not a dark spot: the wall facing the light is the one
              in shadow, and the one facing away from it catches the light.
              Since 2026-09-24 this pair is the whole of the press: no line is
              stroked anywhere on this ball. */
          }
          <radialGradient id="cb-dip-shade">
            <stop offset="0" stop-color="#12100f" stop-opacity="0.27"></stop>
            <stop offset="0.5" stop-color="#12100f" stop-opacity="0.15"></stop>
            <stop offset="1" stop-color="#12100f" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient id="cb-dip-light">
            <stop offset="0" stop-color="#fff" stop-opacity="0.38"></stop>
            <stop offset="0.55" stop-color="#fff" stop-opacity="0.08"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient id="cb-ground">
            <stop offset="0" stop-color="#12100f" stop-opacity="0.2"></stop>
            <stop offset="1" stop-color="#12100f" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <ellipse
          class="contact-bite__ground"
          fill="url(#cb-ground)"
          cx={rest.shadow.cx}
          cy={rest.shadow.cy}
          rx={rest.shadow.rx}
          ry={rest.shadow.ry}
          data-sculpture="shadow"></ellipse>
        <g class="contact-bite__form" data-sculpture="form">
          <use href="#cb-body" fill="#cd5730"></use>
          <g clip-path="url(#cb-clip)">
            <rect width={VIEW_W} height={VIEW_H} fill="url(#cb-shade)"></rect>
            <rect width={VIEW_W} height={VIEW_H} fill="url(#cb-light)"></rect>
            <use href="#cb-body" fill="url(#cb-bounce)"></use>
            <ellipse
              fill="url(#cb-dip-shade)"
              opacity={rest.dip.strength.toFixed(3)}
              cx={rest.dip.shade.cx}
              cy={rest.dip.shade.cy}
              rx={rest.dip.shade.rx}
              ry={rest.dip.shade.ry}
              data-sculpture="dip-shade"></ellipse>
            <ellipse
              fill="url(#cb-dip-light)"
              opacity={rest.dip.strength.toFixed(3)}
              cx={rest.dip.light.cx}
              cy={rest.dip.light.cy}
              rx={rest.dip.light.rx}
              ry={rest.dip.light.ry}
              data-sculpture="dip-light"></ellipse>
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  /*
   * Only says where the contact motion lives. The dynamic import sits in this
   * home-only script so it stays out of the shared motion bundle;
   * `ContactBite.ts`, run by `MotionController`, mounts, restarts and cleans
   * it up. Module scripts run in document order, so this runs first.
   */
  const section = document.querySelector('[data-contact-bite]');
  if (section) {
    Reflect.set(
      section,
      'loadContactBite',
      () => import('@/scripts/motion/ContactBiteMotion'),
    );
  }
</script>
