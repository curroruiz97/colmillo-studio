---
import type { ServiceGlyphVariant } from '@/data/services';

interface Props {
  variant: ServiceGlyphVariant;
}

const { variant } = Astro.props;
---

{
  /*
  Abstract Colmillo glyphs. Pressure, notch, module and trace are the studio's
  own vocabulary: no generic icon set, no illustration. Decorative only, so the
  service title carries the meaning for assistive technology.
*/
}
<svg
  class:list={['service-glyph', `service-glyph--${variant}`]}
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-service-glyph
>
  {
    variant === 'pressure' && (
      <>
        <circle
          class="service-glyph__press service-glyph__press--a"
          cx="33"
          cy="48"
          r="22"
        />
        <circle
          class="service-glyph__press service-glyph__press--b"
          cx="63"
          cy="48"
          r="22"
        />
      </>
    )
  }
  {
    variant === 'notch' && (
      <path
        class="service-glyph__notch"
        d="M77 34.5A32 32 0 1 0 77 61.5L44 48Z"
      />
    )
  }
  {
    variant === 'module' && (
      <>
        <rect
          class="service-glyph__module"
          x="10"
          y="26"
          width="24"
          height="44"
          rx="12"
        />
        <rect
          class="service-glyph__module"
          x="38"
          y="14"
          width="20"
          height="68"
          rx="10"
        />
        <rect
          class="service-glyph__module"
          x="62"
          y="32"
          width="24"
          height="32"
          rx="12"
        />
      </>
    )
  }
  {
    variant === 'trace' && (
      <>
        <path class="service-glyph__trace" d="M12 62c8-26 14-26 22 0" />
        <path class="service-glyph__trace" d="M38 62c8-26 14-26 22 0" />
        <path class="service-glyph__trace" d="M64 62c8-26 14-26 22 0" />
        <path class="service-glyph__trace-rule" d="M8 76h80" />
      </>
    )
  }
</svg>
