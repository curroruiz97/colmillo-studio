---
/**
 * /studio/ — 02 "Somos Colmillo"
 *
 * An asymmetric spread: the headline takes a little over half the width, the
 * text sits in a narrower column to the right and lower down, and nothing is
 * boxed. The only colour is the orange full stop, a short orange rule and the
 * accent at the end of the lede.
 *
 * The headline lines rise out of their own clips and the text settles in once
 * on entry (`StudioPage.ts`); there is no pin.
 */
import { splitClosingMark, type StudioIntroCopy } from '@/data/studioPage';

interface Props {
  intro: StudioIntroCopy;
}

const { intro } = Astro.props;
---

<section
  class="studio-intro"
  aria-labelledby="studio-intro-title"
  data-surface-tone="light"
  data-reveal-group
  data-dev-placeholder={intro.placeholder ? '' : undefined}
>
  <div class="content-shell studio-intro__grid">
    <h2 id="studio-intro-title" class="studio-intro__title">
      {
        intro.title.map((line) => {
          const { text, mark } = splitClosingMark(line);
          return (
            <span class="studio-line">
              <span data-reveal-line>
                {text}
                {mark && <span class="studio-mark">{mark}</span>}
              </span>{' '}
            </span>
          );
        })
      }
    </h2>

    <div class="studio-intro__copy">
      <span class="studio-intro__rule" aria-hidden="true" data-reveal-fade
      ></span>
      <p class="studio-intro__lede" data-reveal-fade>
        {intro.lede.text}
        {
          intro.lede.accent && (
            <>
              {' '}
              <span class="studio-intro__accent">{intro.lede.accent}</span>
            </>
          )
        }
      </p>
      {
        intro.body.map((paragraph) => (
          <p class="studio-intro__body" data-reveal-fade>
            {paragraph}
          </p>
        ))
      }
    </div>
  </div>
</section>
