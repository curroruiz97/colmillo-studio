---
/**
 * /studio/ — 01 Hero
 *
 * Two pieces on the page's charcoal: the title on the left, centred
 * vertically in the first screen by the grid itself, and one audiovisual
 * frame on the right, clear of the right edge. Nothing decorative besides the
 * orange full stop. Portrait screens stack the title over the frame.
 *
 * `studioHeroMedia` (src/config/assets.ts) is the slot for the final loop,
 * played `autoplay muted loop playsinline` without controls and fitted with
 * `object-fit: contain`. While it is `null` the frame holds a plain surface
 * of the same size and no visible note. Loop and surface are decorative, so
 * both are hidden from assistive technology.
 *
 * The empty space under the title is where the Colmillo orbit starts
 * (`data-orbit-station`, an empty marker that is never painted).
 */
import { studioHeroMedia as media } from '@/config/assets';
import { studioHero } from '@/data/studioPage';
---

<header class="studio-hero" data-studio-hero data-surface-tone="dark">
  <div class="studio-shell studio-hero__inner">
    <h1 id="studio-page-title" class="studio-hero__title">
      <span class="studio-line">
        <span data-studio-hero-title
          >{studioHero.title}<span class="studio-hero__dot" aria-hidden="true"
          ></span></span
        >
      </span>
    </h1>

    <div class="studio-hero__media" data-studio-hero-media>
      <div class="studio-hero__frame">
        {
          media ? (
            <video
              class="studio-hero__video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={media.poster}
              width={media.width}
              height={media.height}
              aria-hidden="true"
              tabindex="-1"
              data-studio-hero-video
            >
              <source src={media.webm} type="video/webm" />
              <source src={media.mp4} type="video/mp4" />
            </video>
          ) : (
            <div class="studio-hero__placeholder" aria-hidden="true" />
          )
        }
      </div>
    </div>

    <span
      class="studio-orbit-stop studio-orbit-stop--hero"
      aria-hidden="true"
      data-orbit-station="hero"></span>
  </div>
</header>
