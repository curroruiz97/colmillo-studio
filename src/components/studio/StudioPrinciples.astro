---
/**
 * /studio/ — 03 "Cómo hacemos las cosas"
 *
 * A calm editorial list on the left (Mirar, Pensar, Crear, Lanzar, no
 * numbers) with each description directly under its name, and one small
 * upright picture on the right that follows the open principle: it changes
 * with the principle and slides so its middle stays level with the open row,
 * within the list's height. The empty column between them is the Colmillo
 * orbit's stop in this section (`data-orbit-station`).
 *
 * Markup without JavaScript: every name is a heading with its description
 * open under it, and the picture column shows the first picture only (the
 * pictures are decorative companions of the text, hidden from assistive
 * technology). `StudioPageMotion.ts` upgrades each name into a disclosure
 * button: hover (mouse or pen), focus, click or tap, and ArrowUp/ArrowDown,
 * Home and End open one principle at a time. "Mirar" is open by default.
 * Narrow screens put the picture under the list.
 *
 * Each principle's `image` is its final picture slot; while it is `null` an
 * abstract composition (`art`) stands in.
 */
import type { StudioPrinciplesCopy } from '@/data/studioPage';

interface Props {
  principles: StudioPrinciplesCopy;
}

const { principles } = Astro.props;
---

<section
  class="studio-principles"
  aria-labelledby="studio-principles-title"
  data-surface-tone="dark"
  data-dev-placeholder={principles.placeholder ? '' : undefined}
>
  <div class="studio-shell studio-principles__inner">
    <header class="studio-principles__header" data-reveal-group>
      <h2
        id="studio-principles-title"
        class="studio-principles__title"
        data-reveal-fade
      >
        {principles.title}
      </h2>
    </header>

    <div class="principles" data-principles>
      <ul class="principles__list" role="list" data-principles-list>
        {
          principles.items.map((item, index) => (
            <li
              class="principles__item"
              id={`principio-${item.id}`}
              data-principle-item
              data-active={index === 0 ? '' : undefined}
            >
              <h3 class="principles__name" data-principle-name>
                <span class="principles__label">{item.name}</span>
              </h3>
              <div
                class="principles__desc"
                id={`principio-${item.id}-texto`}
                data-principle-desc
              >
                <div class="principles__desc-inner">
                  <p class="principles__text">{item.description}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="principles__media" aria-hidden="true" data-principles-media>
        {
          principles.items.map((item, index) => (
            <div
              class="principles__figure"
              data-principle-figure
              data-state={index === 0 ? 'active' : 'idle'}
            >
              {item.image ? (
                <img
                  class="principles__image"
                  src={item.image.src}
                  alt=""
                  width={item.image.width}
                  height={item.image.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="principles__placeholder" data-art={item.art}>
                  <span class="principles__ph-shape" />
                  <span class="principles__ph-shape" />
                </div>
              )}
            </div>
          ))
        }
      </div>

      <span
        class="studio-orbit-stop studio-orbit-stop--principles"
        aria-hidden="true"
        data-orbit-station="principles"></span>
    </div>
  </div>
</section>
