---
import MotionControls from './MotionControls.astro';
import { legalNavigation, primaryNavigation } from '@/config/navigation';
import { demoMode } from '@/data/projects';

const path = Astro.url.pathname;
const routeIndex = primaryNavigation.findIndex((item) =>
  item.href === '/' ? path === '/' : path.startsWith(item.href),
);
const routeNumber =
  routeIndex >= 0 ? String(routeIndex + 1).padStart(2, '0') : '—';
const sectionIds = ['inicio', 'manifiesto', 'studio', 'proyectos', 'contacto'];
---

<details class="side-menu" data-side-menu>
  <summary
    class="side-menu__trigger"
    data-menu-trigger
    data-cursor-label="Menú"
    aria-controls="site-menu-panel"
  >
    <span class="side-menu__trigger-mark" aria-hidden="true">
      <span></span><span></span>
    </span>
    <span class="side-menu__trigger-label side-menu__trigger-label--closed"
      >Menú</span
    >
    <span class="side-menu__trigger-label side-menu__trigger-label--open"
      >Cerrar</span
    >
    <span
      class="side-menu__trigger-count"
      data-side-menu-current
      aria-hidden="true"
    >
      {routeNumber}
    </span>
  </summary>

  <div class="side-menu__panel" id="site-menu-panel" data-menu-panel>
    <div class="side-menu__panel-surface">
      <header class="side-menu__panel-header">
        <a href="/" aria-label="Colmillo Studio, inicio">
          <img
            src="/assets/brand/colmillo-wordmark-cream.png"
            width="865"
            height="232"
            alt=""
            decoding="async"
          />
        </a>
        <p>Recorrido / {routeNumber}</p>
      </header>

      <nav class="side-menu__navigation" aria-label="Navegación principal">
        <ol class="side-menu__list">
          {
            primaryNavigation.map((item, index) => (
              <li style={`--menu-item-index: ${index}`}>
                <a
                  href={item.href}
                  data-section-link={sectionIds[index]}
                  data-menu-initial-focus={index === 0 ? '' : undefined}
                  data-cursor-label="Ir"
                  aria-current={
                    routeIndex >= 0 && index === routeIndex ? 'page' : undefined
                  }
                >
                  <span aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <strong>{item.label}</strong>
                  <span class="side-menu__link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <footer class="side-menu__panel-footer">
        <a
          class="side-menu__projects"
          href="/proyectos/"
          data-cursor-label="Ver"
        >
          {demoMode ? 'Ver archivo completo' : 'Ver proyectos'}
        </a>
        <MotionControls />
        <nav aria-label="Información legal">
          <ul role="list">
            {
              legalNavigation.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </footer>
    </div>
  </div>
</details>
