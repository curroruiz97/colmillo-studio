---
/**
 * COLMILLO EDGE MENU
 *
 * The primary navigation lives against the right edge of the viewport. One
 * state machine in `EdgeMenu.ts` declares it on the wrapper as `data-state`:
 *
 *   closed    a small orange tab pressed against the edge, nothing else
 *   tracking  a fine pointer is near the edge: the tab follows it vertically
 *             and reaches a few pixels further into the page
 *   open      the panel presses in and the tab becomes the close control,
 *             declared as `data-close="expanded"` or `"collapsed"` once it has
 *             retracted to a sliver
 *
 * The native `<details>` disclosure stays the accessible control so the menu
 * works with no JavaScript, with the keyboard and with a screen reader. When
 * JavaScript is available `EdgeMenu.ts` marks the wrapper `data-enhanced`, moves
 * the panel out of the disclosure so it can animate in both directions, and
 * owns the state machine.
 *
 * The carrier is the only thing that moves vertically. It holds both visible
 * pieces of the summary - the closed tab and the close control - so the tab
 * that was pressed becomes the close control in the same place.
 */
import { publishedContactChannels } from '@/config/contact';
import { primaryNavigation } from '@/config/navigation';

const path = Astro.url.pathname;
const routeIndex = primaryNavigation.findIndex((item) =>
  item.href === '/' ? path === '/' : path.startsWith(item.href),
);

/*
 * The active route is decided here, from the URL, and never changes while the
 * page scrolls: on `/` "Inicio" stays current even when a home section that
 * shares a route's name is in view.
 *
 * The panel carries no numbering and no legal links (2026-09-15, client
 * direction): the routes, the channels and the footer's legal line suffice.
 * External channels open in a new tab; `mailto:` stays in place.
 */
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<div class="edge-menu" data-edge-menu data-state="closed">
  <div class="edge-menu__carrier" data-edge-carrier>
    <details class="edge-menu__disclosure" data-edge-disclosure>
      <summary
        class="edge-menu__handle"
        data-edge-trigger
        aria-controls="site-menu-panel"
        aria-expanded="false"
      >
        <span class="edge-menu__tab" data-edge-tab aria-hidden="true">
          <span class="edge-menu__ticks">
            <span></span><span></span><span></span>
          </span>
        </span>
        <span class="edge-menu__close" data-edge-closer>
          <span class="edge-menu__close-word">Cerrar</span>
        </span>
        <span class="visually-hidden">Menú</span>
      </summary>

      <div class="edge-menu__panel" id="site-menu-panel" data-edge-panel>
        <span class="edge-menu__skin" aria-hidden="true"></span>

        <div class="edge-menu__content">
          <header class="edge-menu__head">
            <img
              class="edge-menu__wordmark"
              src="/assets/brand/colmillo-wordmark-cream.png"
              width="865"
              height="232"
              alt="Colmillo Studio"
              decoding="async"
            />
          </header>

          <nav class="edge-menu__navigation" aria-label="Navegación principal">
            <ol class="edge-menu__list">
              {
                primaryNavigation.map((item, index) => (
                  <li style={`--edge-item: ${index}`}>
                    <a
                      href={item.href}
                      data-edge-initial-focus={index === 0 ? '' : undefined}
                      data-cursor-label="Ir"
                      aria-current={
                        routeIndex >= 0 && index === routeIndex
                          ? 'page'
                          : undefined
                      }
                    >
                      <span class="edge-menu__row">
                        <strong>{item.label}</strong>
                        <span class="edge-menu__mark" aria-hidden="true" />
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>

          <footer class="edge-menu__foot">
            {
              publishedContactChannels.length > 0 && (
                <ul class="edge-menu__channels" role="list">
                  {publishedContactChannels.map((channel) => {
                    const external = isExternal(channel.href);
                    return (
                      <li>
                        <a
                          href={channel.href}
                          target={external ? '_blank' : undefined}
                          rel={external ? 'noopener noreferrer' : undefined}
                          data-cursor-label="Abrir"
                        >
                          <span class="edge-menu__channel-label">
                            {channel.label}
                          </span>
                          <strong>{channel.value ?? channel.label}</strong>
                          {external && (
                            <span class="visually-hidden">
                              (se abre en una pestaña nueva)
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )
            }
          </footer>
        </div>
      </div>
    </details>
  </div>

  {
    /*
     * A real button rather than a clickable div. It duplicates Escape and the
     * close control, so it is kept out of the accessibility tree and the tab
     * order.
     */
  }
  <button
    class="edge-menu__scrim"
    type="button"
    data-edge-close
    tabindex="-1"
    aria-hidden="true"></button>
</div>
