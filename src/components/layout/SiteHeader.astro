---
import { publishedContactChannels } from '@/config/contact';
import { legalNavigation, primaryNavigation } from '@/config/navigation';

const isHome = Astro.url.pathname === '/';
const usesDarkChrome = Astro.url.pathname.startsWith('/contacto');
const currentPage = [...primaryNavigation, ...legalNavigation].find((item) =>
  item.href === '/'
    ? Astro.url.pathname === '/'
    : Astro.url.pathname.startsWith(item.href),
);
const currentPageLabel =
  currentPage?.label ??
  (Astro.url.pathname === '/404.html'
    ? '404'
    : (Astro.url.pathname
        .split('/')
        .filter(Boolean)
        .at(-1)
        ?.replaceAll('-', ' ') ?? 'Colmillo Studio'));
const logo = usesDarkChrome
  ? {
      src: '/assets/brand/colmillo-wordmark-cream.png',
      width: 865,
      height: 232,
    }
  : {
      src: '/assets/brand/colmillo-wordmark-black.png',
      width: 906,
      height: 242,
    };
---

<header
  class="site-header"
  data-sticky-header
  data-tone={usesDarkChrome ? 'dark' : 'light'}
  data-visible={isHome ? 'false' : 'true'}
  inert={isHome}
>
  <a class="wordmark" href="/" aria-label="Colmillo Studio, inicio">
    <img
      class="wordmark__image"
      src={logo.src}
      width={logo.width}
      height={logo.height}
      alt=""
      decoding="async"
      fetchpriority="high"
    />
  </a>
  {
    publishedContactChannels.length > 0 ? (
      <nav aria-label="Contacto rápido">
        <ul class="site-header__nav" role="list">
          {publishedContactChannels.map((channel) => (
            <li>
              <a href={channel.href}>{channel.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <p class="site-header__context" aria-hidden="true">
        <span>Colmillo Studio</span>
        <span>{currentPageLabel}</span>
      </p>
    )
  }
</header>
