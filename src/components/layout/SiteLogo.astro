---
/**
 * COLMILLO WORDMARK
 *
 * One global link home in the top-left corner of every route's first screen,
 * with the size and the gutter the wordmark has on the home hero
 * (`--brand-logo-inline`, `--page-gutter`). It is not fixed: it scrolls away
 * with the first screen. The home hero keeps an empty box of the same size
 * where the mark used to sit, so its composition is unchanged.
 *
 * The route declares the tone of its hero through the layout's `headerTheme`.
 *
 * Since 2026-09-23 the orange derivative is the mark on every route (client
 * direction), so `mark` defaults to it and `headerTheme` no longer picks the
 * colour — it still publishes `data-theme`, which the cursor's surface tone
 * and the route's own styles read. A route can still ask for the tone-matched
 * black or cream mark with `mark="auto"`; none does.
 *
 * No filter is involved anywhere: each colour is its own validated file.
 */
import { brandWordmark } from '@/config/assets';

export type HeaderTheme = 'light' | 'dark';
/** `orange` is the mark everywhere; `auto` follows the route's tone instead. */
export type LogoMark = 'auto' | 'orange';

interface Props {
  theme?: HeaderTheme;
  mark?: LogoMark;
}

const { theme = 'light', mark: choice = 'orange' } = Astro.props;
const mark =
  choice === 'orange'
    ? brandWordmark.orange
    : theme === 'dark'
      ? brandWordmark.cream
      : brandWordmark.black;
const isHome = Astro.url.pathname === '/';
---

<a
  class="site-logo"
  href="/"
  aria-label="Colmillo Studio, inicio"
  aria-current={isHome ? 'page' : undefined}
  data-site-logo
  data-theme={theme}
>
  <img
    class="site-logo__mark"
    src={mark.src}
    width={mark.width}
    height={mark.height}
    alt=""
    decoding="async"
    fetchpriority="high"
  />
</a>
