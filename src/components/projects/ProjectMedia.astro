---
import type { ProjectMediaItem } from '@/data/projects';

interface Props {
  media: ProjectMediaItem;
  eager?: boolean;
  class?: string;
  /** The surrounding link already names the project, so the cover is ornament. */
  decorative?: boolean;
}

const {
  media,
  eager = false,
  class: className = '',
  decorative = false,
} = Astro.props;
---

{
  media.src ? (
    <img
      class={className}
      src={media.src}
      alt={decorative ? '' : media.alt}
      width={media.width}
      height={media.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div
      class:list={['project-composition', className]}
      data-composition={media.variant}
      role={decorative ? undefined : 'img'}
      aria-label={decorative ? undefined : media.alt}
      aria-hidden={decorative ? 'true' : undefined}
      style={`--media-ratio: ${media.width} / ${media.height}`}
    >
      <span aria-hidden="true" />
      <span aria-hidden="true" />
      <span aria-hidden="true" />
    </div>
  )
}
