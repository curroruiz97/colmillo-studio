---
import type { ProjectMediaItem } from '@/data/projects';

interface Props {
  media: ProjectMediaItem;
  eager?: boolean;
  class?: string;
}

const { media, eager = false, class: className = '' } = Astro.props;
---

{
  media.src ? (
    <img
      class={className}
      src={media.src}
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div
      class:list={['project-composition', className]}
      data-composition={media.variant}
      role="img"
      aria-label={media.alt}
      style={`--media-ratio: ${media.width} / ${media.height}`}
    >
      <span aria-hidden="true" />
      <span aria-hidden="true" />
      <span aria-hidden="true" />
    </div>
  )
}
