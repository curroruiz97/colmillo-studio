---
import Footer from '@/components/layout/Footer.astro';
import EdgeMenu from '@/components/layout/EdgeMenu.astro';
import InstagramBadge from '@/components/layout/InstagramBadge.astro';
import SeoHead from '@/components/layout/SeoHead.astro';
import SiteLogo, {
  type HeaderTheme,
  type LogoMark,
} from '@/components/layout/SiteLogo.astro';
import '@/styles/index.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  hideNavigation?: boolean;
  /**
   * Tone of the route's first screen, for the global wordmark: `light` (white
   * or orange hero) shows the black mark, `dark` (ink or charcoal) the cream
   * one.
   */
  headerTheme?: HeaderTheme;
  /**
   * Which validated wordmark the route paints. The default is `orange` on
   * every route since 2026-09-23 (client direction); `auto` asks for the
   * derivative that matches `headerTheme` instead. No route sets it today.
   */
  logoMark?: LogoMark;
  /**
   * Drops the global corner wordmark, for a route that carries its own. Only
   * `/proyectos/<slug>/` does: its header centres the mark between its own
   * "Proyectos" link and the Instagram control, which both stay.
   */
  hideLogo?: boolean;
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  noindex,
  hideNavigation = false,
  hideLogo = false,
  headerTheme = 'light',
  logoMark = 'orange',
  ogImage,
  ogImageAlt,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title={title}
      description={description}
      noindex={noindex}
      image={ogImage}
      imageAlt={ogImageAlt}
      type={ogType}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot name="overlay" />
    {
      !hideNavigation && !hideLogo && (
        <SiteLogo theme={headerTheme} mark={logoMark} />
      )
    }
    {!hideNavigation && <EdgeMenu />}
    {!hideNavigation && <InstagramBadge />}
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    {!hideNavigation && <Footer />}
    <div class="custom-cursor" data-custom-cursor aria-hidden="true">
      <span class="custom-cursor__shape">
        <span class="custom-cursor__core"></span>
        <span class="custom-cursor__label" data-cursor-text></span>
      </span>
    </div>
    <script>
      import { initMotion } from '@/scripts/motion/MotionController';

      initMotion();
    </script>
  </body>
</html>
