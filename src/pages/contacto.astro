---
/**
 * /contacto/ — a conversation that starts.
 *
 * Two scenes and the global footer, nothing else (2026-09-16, user direction).
 * The charcoal hero states the question and carries the route's own graphic,
 * an unfinished orange trajectory; then one white sheet rises over it and
 * holds the whole brief. The direct channels live inside that sheet's left
 * block, so the page needs no closing strip and no "meanwhile" map back into
 * the site — the edge menu is the navigation.
 *
 * Copy is centralised in `src/data/contactPage.ts`; the address and the
 * profile come from the approved `src/config/contact.ts` and are never
 * written here. Nothing on this route is fictional, so both builds render it
 * in full.
 */
import ContactForm from '@/components/contact/ContactForm.astro';
import ContactHero from '@/components/contact/ContactHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto"
  description="Escribe a Colmillo Studio: cuéntanos el proyecto que tienes entre manos y empezamos por ahí."
  headerTheme="dark"
>
  <article
    class="contact-route"
    aria-labelledby="contact-page-title"
    data-contact-page
  >
    <ContactHero />
    <ContactForm />
  </article>

  <script>
    /*
     * Only says where the page's motion lives. The dynamic import sits in this
     * route-only script so the chunk stays out of the shared motion bundle;
     * `ContactPage.ts`, run by `MotionController`, mounts, restarts and cleans
     * it up. It must stay inside the layout's slot: module scripts run in
     * document order, and this one has to run before the layout's own.
     */
    const page = document.querySelector('[data-contact-page]');
    if (page) {
      Reflect.set(
        page,
        'loadContactPage',
        () => import('@/scripts/motion/ContactPageMotion'),
      );
    }
  </script>
</BaseLayout>
