---
/**
 * /servicios/ — a stack of editorial layers: the hero, one layer per service
 * (Estrategia, Identidad, Digital, Contenido) and a closing decision.
 *
 * On wide screens with motion allowed every layer is a sticky plate of the
 * shared section stack (`SectionStack.ts`): the next one rises over it with a
 * rounded band while it waits, slightly compressed, underneath. Phones,
 * portrait tablets, short windows, reduced motion and no JavaScript read the
 * same layers one after another, each tucked a little under the previous one.
 *
 * Copy lives in `src/data/servicesPage.ts` and the hero piece's slot in
 * `src/config/assets.ts`. The service layers are provisional copy, so the
 * standard build renders the hero and the close only.
 */
import ServiceSection from '@/components/services/ServiceSection.astro';
import ServicesClose from '@/components/services/ServicesClose.astro';
import ServicesHero from '@/components/services/ServicesHero.astro';
import { servicesClose, servicesLayers } from '@/data/servicesPage';
import BaseLayout from '@/layouts/BaseLayout.astro';

const layers = servicesLayers?.layers ?? [];
const placeholder = servicesLayers?.placeholder ?? false;
---

<BaseLayout title="Servicios" description="Servicios de Colmillo Studio.">
  <article
    class="services-page"
    aria-labelledby="services-page-title"
    data-services-page
  >
    <ServicesHero />
    {
      layers.map((service) => (
        <ServiceSection service={service} placeholder={placeholder} />
      ))
    }
    <ServicesClose close={servicesClose} />
  </article>

  <script>
    /*
     * Only says where the page's motion lives. The dynamic import sits in this
     * route-only script so the chunk stays out of the shared motion bundle;
     * `ServicesPage.ts`, run by `MotionController`, mounts, restarts and
     * cleans it up. It must stay inside the layout's slot: module scripts run
     * in document order, and this one has to run before the layout's own.
     */
    const page = document.querySelector('[data-services-page]');
    if (page) {
      Reflect.set(
        page,
        'loadServicesPage',
        () => import('@/scripts/motion/ServicesPageMotion'),
      );
    }
  </script>
</BaseLayout>
