---
import { getCollection } from 'astro:content';
import ContactSection from '@/components/sections/ContactSection.astro';
import GoodbyeSection from '@/components/sections/GoodbyeSection.astro';
import HomeIntro from '@/components/intro/HomeIntro.astro';
import HomeIntroBoot from '@/components/intro/HomeIntroBoot.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import IntroSection from '@/components/sections/IntroSection.astro';
import ProjectsHorizontal from '@/components/sections/ProjectsHorizontal.astro';
import ServicesSection from '@/components/sections/ServicesSection.astro';
import StudioSection from '@/components/sections/StudioSection.astro';
import { contentAvailability } from '@/config/content';
import { homeGoodbye } from '@/data/goodbye';
import {
  demoMode,
  demoProjects,
  HOME_PROJECT_LIMIT,
  normalizeProject,
  sortProjectEntries,
} from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = (
  demoMode
    ? demoProjects
    : contentAvailability.projects
      ? sortProjectEntries(
          (await getCollection('projects')).filter(
            (project) => !project.data.draft,
          ),
        ).map(normalizeProject)
      : []
).slice(0, HOME_PROJECT_LIMIT);
const showIntro = demoMode || contentAvailability.homeIntro;
---

<BaseLayout logoMark="orange">
  <HomeIntroBoot slot="head" />
  <HomeIntro slot="overlay" />
  <HeroSection />
  {showIntro && <IntroSection />}
  {(demoMode || contentAvailability.services) && <ServicesSection />}
  <ProjectsHorizontal projects={projects} />
  {(demoMode || contentAvailability.studio) && <StudioSection />}
  {homeGoodbye && <GoodbyeSection content={homeGoodbye} />}
  <ContactSection />
</BaseLayout>
