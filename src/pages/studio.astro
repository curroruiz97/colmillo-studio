---
/**
 * /studio/ — hero, "Somos Colmillo", the four principles, the team and one
 * closing call to action, with the Colmillo orbit travelling through them.
 *
 * Content lives in `src/data/studioPage.ts` and the hero loop slot in
 * `src/config/assets.ts`. Blocks whose copy is still provisional resolve to
 * `null` in the standard build and are not rendered there; development and
 * `build:demo` show the complete page.
 */
import StudioCTA from '@/components/studio/StudioCTA.astro';
import StudioHero from '@/components/studio/StudioHero.astro';
import StudioIntro from '@/components/studio/StudioIntro.astro';
import StudioPrinciples from '@/components/studio/StudioPrinciples.astro';
import StudioRing from '@/components/studio/StudioRing.astro';
import StudioTeam from '@/components/studio/StudioTeam.astro';
import {
  studioClose,
  studioIntro,
  studioPrinciples,
  studioTeam,
} from '@/data/studioPage';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio"
  description="Página de estudio de Colmillo Studio."
  headerTheme="dark"
>
  <article
    class="studio-page"
    aria-labelledby="studio-page-title"
    data-studio-page
  >
    <!-- The Colmillo orbit: one ring that travels the page behind the content
         (`StudioOrbit.ts`). Hidden until the script sends it on its way. -->
    <div class="studio-orbit" aria-hidden="true" data-studio-orbit>
      <StudioRing />
    </div>
    <StudioHero />
    {studioIntro && <StudioIntro intro={studioIntro} />}
    {studioPrinciples && <StudioPrinciples principles={studioPrinciples} />}
    {studioTeam && <StudioTeam team={studioTeam} />}
    <StudioCTA close={studioClose} />
  </article>

  <script>
    /*
     * Only says where the page's motion lives. The dynamic import sits in this
     * route-only script so the chunk stays out of the shared motion bundle;
     * `StudioPage.ts`, run by `MotionController`, mounts, restarts and cleans
     * it up. It must stay inside the layout's slot: module scripts run in
     * document order, and this one has to run before the layout's own.
     */
    const page = document.querySelector('[data-studio-page]');
    if (page) {
      Reflect.set(
        page,
        'loadStudioPage',
        () => import('@/scripts/motion/StudioPageMotion'),
      );
    }
  </script>
</BaseLayout>
