---
/**
 * /proyectos/[slug]/ — the case study.
 *
 * One template, identical on every project (client direction, 2026-09-23):
 * the route's own header and the brief beside the work. There is no hero, no
 * module sequence and no next-project stage — a project is its name, its story
 * in three parts and its pieces, and every project is read the same way.
 * `CaseStudyBrief.astro` is the whole composition; the way on is the button to
 * Contacto inside it, and the way back is the header's own link. The model, its fallbacks and the authoring guide are
 * `src/data/caseStudy.ts` and `docs/CASE_STUDIES.md`.
 *
 * Content follows the archive exactly: the standard build publishes approved
 * entries only, so with none approved this route generates no pages at all and
 * `/proyectos/<anything>/` is a 404 in `dist/`. Development and `build:demo`
 * render the ten provisional pieces, two of them with an authored study and
 * the rest through the automatic fallback — which is exactly what an approved
 * project looks like on the day its entry lands.
 *
 * The way out of a project is the header's link back to the archive and the
 * button on to Contacto; the route carries no previous/next of its own.
 */
import CaseStudyBrief from '@/components/case-study/CaseStudyBrief.astro';
import CaseStudyHeader from '@/components/case-study/CaseStudyHeader.astro';
import { getCollection } from 'astro:content';
import { contentAvailability } from '@/config/content';
import { resolveCaseStudy, type CaseStudyInput } from '@/data/caseStudy';
import { caseStudies } from '@/data/caseStudies';
import {
  demoMode,
  demoProjects,
  normalizeProject,
  sortProjectEntries,
} from '@/data/projects';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';

export async function getStaticPaths() {
  const entries =
    !demoMode && contentAvailability.projects
      ? sortProjectEntries(
          await getCollection('projects', ({ data }) => !data.draft),
        )
      : [];
  const projects = demoMode ? demoProjects : entries.map(normalizeProject);

  return projects.map((project, index) => {
    return {
      params: { slug: project.slug },
      props: { project, entry: entries[index] },
    };
  });
}

/*
 * The props are inferred from `getStaticPaths` above, so this page declares no
 * `Props` interface of its own: one source of truth for what a project route
 * receives. There is no previous/next navigation by design since 2026-09-23 —
 * the archive is one click away in the route's own header.
 */
const { entry, project } = Astro.props;

/*
 * Approved frontmatter first, then a registered demonstration study, then the
 * automatic fallback built from the archive's own record.
 */
const authored: CaseStudyInput | undefined =
  (entry?.data.caseStudy as CaseStudyInput | undefined) ??
  caseStudies[project.slug];
const study = resolveCaseStudy(project, authored);
---

<CaseStudyLayout study={study} description={project.summary}>
  <CaseStudyHeader chrome={study.theme.chrome} />
  <CaseStudyBrief study={study} />
</CaseStudyLayout>
