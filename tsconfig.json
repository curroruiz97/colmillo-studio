{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "dist-demo",
    "node_modules",
    "playwright-report",
    "test-results"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
