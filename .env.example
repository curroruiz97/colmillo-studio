# Required before public launch. Use the final canonical origin without a path.
# PUBLIC_SITE_URL=https://example.com

# Set to true only after all client assets/content/legal QA and release review.
PUBLIC_RELEASE_APPROVED=false

# Keep false until robots.txt and the final indexing review are explicitly approved.
PUBLIC_INDEXING_APPROVED=false

# Release tooling also accepts REQUIRE_CLIENT_ASSETS=true|false. Leave it
# undefined for normal prelaunch checks; set true only in release CI.
